APP_NAME="IT Smart Queue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://q.thonglorpet.com:5886

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=tlph
DB_USERNAME=eservices
DB_PASSWORD=
DB_SCHEMA=intra_tl
DB_TIMEZONE=Asia/Bangkok

BMS_DB_HOST=127.0.0.1
BMS_DB_PORT=1433
BMS_DB_DATABASE=BMSDB
BMS_DB_USERNAME=
BMS_DB_PASSWORD=
BMS_DB_ENCRYPT=no
BMS_DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SAME_SITE=none and SESSION_SECURE_COOKIE=true when embedded cross-origin over HTTPS
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

CSP_FRAME_ANCESTORS="self http://imedx-uat.thonglorpet.com:9444 https://imedx-uat.thonglorpet.com:9444"
